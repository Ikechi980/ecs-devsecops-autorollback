# Copy to terraform.tfvars (git-ignored) and adjust.
name        = "ecs-autorollback"
region      = "us-east-1"
vpc_cidr    = "10.20.0.0/16"
availability_zone_ids = ["use1-az2", "use1-az4"]
github_repo = "Ikechi980/ecs-devsecops-autorollback"

# ALB
allowed_ingress_cidrs   = ["0.0.0.0/0"] # e.g. ["203.0.113.10/32"] to restrict to your IP
certificate_arn         = ""            # ACM cert ARN to enable HTTPS
alb_deletion_protection = false         # true in real prod; false so demo stacks can be destroyed
